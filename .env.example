# Copy to .env and fill in. .env is gitignored; this file holds names only.
# Several keys per provider are intentional: free tiers are small and the
# KeyPool rotates between them when one hits a rate limit or runs out of quota.
# Leave unused lines empty - empty variables are skipped, not treated as keys.

# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=

# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_API_KEY_2=

# https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_API_KEY_2=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_API_KEY_2=

# A local OpenAI-compatible server (llama.cpp, vLLM, Ollama): any non-empty value
LOCAL_API_KEY=
